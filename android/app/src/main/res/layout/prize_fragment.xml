<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:anybutton="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="@dimen/default_large_margin"
    app:divider="@drawable/divider"
    app:dividerPadding="@dimen/simple_dialog_header_left_margin"
    app:showDividers="middle">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_header_height"
        android:layout_marginHorizontal="@dimen/simple_dialog_header_left_margin"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/prizeDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/congrats_25_prize_title"
            android:textAppearance="@style/TextAppearance.OC.Headline5" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:padding="@dimen/default_large_margin"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:gravity="center"
        android:layout_margin="@dimen/default_large_margin"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/competitionCompleteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:layout_marginVertical="@dimen/default_gap"
            android:text="@string/congrats_25_prize_text"
            android:textColor="@color/colorOnPrimary"
            android:textSize="@dimen/tutorial_text_size" />

        <Button
            android:id="@+id/redeemButton"
            style="@style/OC.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yantramanav_bold"
            android:paddingVertical="@dimen/default_gap"
            android:backgroundTint="@color/letterRewardedColor"
            android:textColor="@color/textOnRewardedColor"
            android:text="@string/redeem_now"
            android:textAppearance="@style/TextAppearance.OC.Headline5"
            android:textSize="@dimen/tutorial_primary_button_text_size" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
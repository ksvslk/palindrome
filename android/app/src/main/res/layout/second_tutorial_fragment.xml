<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:saveEnabled="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/default_large_margin"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".fragments.SecondTutorialFragment">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_margin="@dimen/default_large_margin"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:saveEnabled="false"
            style="@style/Widget.Material3.Button.TonalButton"
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yantramanav_bold"
            android:text="@string/play"
            android:textAppearance="@style/TextAppearance.OC.Headline5"
            android:textSize="@dimen/tutorial_primary_button_text_size" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:saveEnabled="false"
        android:id="@+id/competitionAnnouncement"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatTextView
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/default_large_margin"
            android:gravity="start"
            android:text="@string/tutorial_25_level_promo"
            android:textSize="@dimen/tutorial_text_size" />
        <androidx.appcompat.widget.AppCompatTextView
            android:saveEnabled="false"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/default_large_margin"
            android:paddingHorizontal="@dimen/default_large_margin"
            android:gravity="start"
            android:layout_gravity="center"
            android:textSize="@dimen/tutorial_text_size" />
        <androidx.appcompat.widget.AppCompatImageView
            android:saveEnabled="false"
            
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/stairs">
        </androidx.appcompat.widget.AppCompatImageView>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatTextView
        android:saveEnabled="false"
        
        android:id="@+id/tutorialCompleteText"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/default_large_margin"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:text="@string/tutorial_complete_text"
        android:textSize="@dimen/tutorial_text_size" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:saveEnabled="false"
        
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/default_gap"
        android:animateLayoutChanges="true"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="horizontal">
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
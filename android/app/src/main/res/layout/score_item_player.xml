<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:saveEnabled="false"
    tools:viewBindingIgnore="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/simple_dialog_item_height"
    android:layout_marginHorizontal="@dimen/default_large_margin"
    android:orientation="horizontal">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:background="?attr/selectableItemBackground"
        android:weightSum="11"
        android:orientation="horizontal">

        <ImageView
            android:saveEnabled="false"
            android:id="@+id/icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/rewarded_place_letter"
            app:srcCompat="@drawable/letter_icon"
            app:tint="?colorOnPrimaryContainer"
            android:layout_marginEnd="@dimen/default_large_margin"
            android:layout_weight="1"
            tools:ignore="RtlSymmetry" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:saveEnabled="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layout_weight="8"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="false"
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Name"
                android:textAppearance="@style/TextAppearance.OC.Body1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="false"
                android:id="@+id/score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Score"
                android:textAppearance="@style/TextAppearance.OC.Caption" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatTextView
            android:saveEnabled="false"
            android:id="@+id/rank"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="2"
            android:gravity="center"
            android:text="#"
            android:textAppearance="@style/TextAppearance.OC.Headline6" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
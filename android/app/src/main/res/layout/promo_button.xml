<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/simple_dialog_item_height"
    android:gravity="center"
    android:saveEnabled="true"
    android:background="?attr/colorPrimary"
    tools:viewBindingIgnore="true">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="@dimen/default_large_margin"
        android:orientation="horizontal"
        android:saveEnabled="true">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/promo_button_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/default_large_margin"
            android:contentDescription="@string/rewarded_place_letter"
            android:saveEnabled="true"
            android:tint="?colorOnPrimary"
            app:srcCompat="@drawable/letter_icon"
            tools:ignore="RtlSymmetry" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="8"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:saveEnabled="true">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:saveEnabled="true">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/promo_button_title"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/simple_dialog_item_height_almost_half"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?colorOnPrimary"
                    android:saveEnabled="true"
                    android:text="@string/placeholder" />
            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/default_gap"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/promo_button_trailing_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_badge"
                android:backgroundTint="?attr/colorTertiaryContainer"
                android:gravity="center"
                android:text="☃︎︎"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="?attr/colorOnTertiaryContainer" />
        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
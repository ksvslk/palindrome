<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:anybutton="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="@dimen/default_large_margin"
        android:saveEnabled="true"
        app:divider="@drawable/divider"
        app:showDividers="middle">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:saveEnabled="true"
            android:layout_marginHorizontal="@dimen/default_large_margin"
            android:weightSum="7">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/vibration_button"
                android:layout_width="0dp"
                android:layout_height="@dimen/simple_dialog_item_height"
                android:layout_weight="3"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:saveEnabled="true">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/vibration_switch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:clickable="false"
                    android:layoutDirection="rtl"
                    android:saveEnabled="true"
                    android:text="@string/vibration_text"
                    android:gravity="center|start"
                    android:maxLines="1"
                    app:autoSizeMaxTextSize="@dimen/body_large_text_size"
                    app:autoSizeTextType="uniform" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/sound_button"
                android:layout_width="0dp"
                android:layout_height="@dimen/simple_dialog_item_height"
                android:layout_weight="3"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:saveEnabled="true">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sound_switch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:clickable="false"
                    android:layoutDirection="rtl"
                    android:saveEnabled="true"
                    android:gravity="center|start"
                    android:maxLines="1"
                    app:autoSizeMaxTextSize="@dimen/body_large_text_size"
                    app:autoSizeTextType="uniform"
                    android:text="@string/sound_text" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.indest.hah.views.AnyButton
            android:id="@+id/tutorial_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/simple_dialog_item_height"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:saveEnabled="true"
            anybutton:any_button_icon="@drawable/baseline_help_center_black_36"
            anybutton:any_button_title="@string/tutorial" />


        <com.indest.hah.views.AnyButton
            android:id="@+id/rate_game_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/simple_dialog_item_height"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:saveEnabled="true"
            anybutton:any_button_icon="@drawable/baseline_rate_review_black_36"
            anybutton:any_button_title="@string/rate_game" />

        <com.indest.hah.views.AnyButton
            android:id="@+id/twitter_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/simple_dialog_item_height"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:saveEnabled="true"
            anybutton:any_button_icon="@drawable/x_logo"
            anybutton:any_button_title="@string/follow" />

        <com.indest.hah.views.AnyButton
            android:id="@+id/share_button_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/simple_dialog_item_height"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:saveEnabled="true"
            anybutton:any_button_icon="@drawable/baseline_share_black_36"
            anybutton:any_button_title="@string/share" />

        <com.indest.hah.views.AnyButton
            android:id="@+id/select_app_locale_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/simple_dialog_item_height"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:saveEnabled="true"
            anybutton:any_button_icon="@drawable/es"
            anybutton:any_button_title="@string/menu_language" />

        <com.indest.hah.views.AnyButton
            android:id="@+id/privacy_policy_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/privacy_policy_height"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:saveEnabled="true"
            android:gravity="center|start"
            android:layout_marginVertical="@dimen/default_padding_text"
            android:maxLines="1"
            app:autoSizeMaxTextSize="@dimen/body_large_text_size"
            app:autoSizeTextType="uniform"
            anybutton:any_button_icon="@drawable/baseline_info_36"
            anybutton:any_button_title="@string/privacy_policy" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.core.widget.NestedScrollView>
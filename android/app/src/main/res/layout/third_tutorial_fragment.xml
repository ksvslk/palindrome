<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/third_tutorial_fragment"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/tutorial_container_margin"
    android:gravity="center"
    android:orientation="vertical"
    app:divider="@drawable/divider"
    app:dividerPadding="@dimen/simple_dialog_left_margin"
    app:showDividers="middle"
    tools:context=".fragments.ThirdTutorialFragment">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/default_large_margin"
        android:padding="@dimen/default_large_margin"
        android:layout_weight="1.5"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tutorial"
            android:textColor="@color/colorOnPrimary"
            android:textSize="@dimen/tutorial_title_text_size" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="@dimen/tutorial_progress_width"
            android:layout_height="match_parent"
            android:progress="100"
            app:indicatorColor="@color/hintsNotificationColor" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.5"
        android:layout_margin="@dimen/default_large_margin"
        android:padding="@dimen/default_large_margin"
        android:textAlignment="center"
        android:gravity="center"
        android:text="@string/tutorial3_text"
        android:textColor="@color/colorOnPrimary"
        android:textSize="@dimen/tutorial_text_size" />

    <FrameLayout
        android:id="@+id/tutorialGameplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/default_large_margin"
        android:padding="@dimen/default_large_margin"
        android:layout_weight="2.5"
        android:animateLayoutChanges="true"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/tutorial_letters_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:animateLayoutChanges="true"
            android:background="@color/colorBackground"
            android:clipChildren="false"
            android:splitMotionEvents="false"
            android:visibility="visible"
            app:columnCount="4"
            app:useDefaultMargins="true">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letter1"
                android:layout_width="@dimen/tutorial_box_size"
                android:layout_height="@dimen/tutorial_box_size"
                android:background="@color/colorPrimary"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:text="H"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/tutorial_box_text_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letter2"
                android:layout_width="@dimen/tutorial_box_size"
                android:layout_height="@dimen/tutorial_box_size"
                android:background="@color/colorPrimary"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/tutorial_box_text_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letter3"
                android:layout_width="@dimen/tutorial_box_size"
                android:layout_height="@dimen/tutorial_box_size"
                android:background="@color/colorPrimary"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:text="H"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/tutorial_box_text_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letter4"
                android:layout_width="@dimen/tutorial_box_size"
                android:layout_height="@dimen/tutorial_box_size"
                android:background="@color/colorPrimary"
                android:backgroundTint="@color/hintsNotificationColor"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:text="!"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/tutorial_box_text_size" />
        </androidx.gridlayout.widget.GridLayout>

    </FrameLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:animateLayoutChanges="true"
        android:clipChildren="false"
        android:layout_margin="@dimen/default_large_margin"
        android:padding="@dimen/default_large_margin"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/startButton"
            style="@style/OC.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yantramanav_bold"
            android:paddingHorizontal="@dimen/_32sdp"
            android:paddingVertical="@dimen/default_gap"
            android:text="@string/lets_go"
            android:textAppearance="@style/TextAppearance.OC.Headline5"
            android:textSize="@dimen/tutorial_primary_button_text_size" />

    </androidx.appcompat.widget.LinearLayoutCompat>


</androidx.appcompat.widget.LinearLayoutCompat>
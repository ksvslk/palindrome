<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tutorial_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/default_large_margin"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".fragments.TutorialFragment">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tutorial"
            android:textSize="@dimen/_25ssp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="@dimen/_100sdp"
            android:layout_height="match_parent"
            android:progress="50"
            app:indicatorColor="@color/hintsNotificationColor" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/default_large_margin"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingHorizontal="@dimen/default_large_margin"
        android:text="Palindrome is a word or sentence that is same when reading from left to right or right to left."
        android:textSize="@dimen/_16ssp" />

    <FrameLayout
        android:id="@+id/tutorialGameplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:animateLayoutChanges="true"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/hand"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:background="@drawable/ic_baseline_touch_app_up_24"
            android:elevation="2dp" />

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:animateLayoutChanges="true"
            android:background="@color/colorBackground"
            android:clipChildren="false"
            android:splitMotionEvents="false"
            android:visibility="visible"
            app:columnCount="3">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letter1"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:background="@color/colorPrimary"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:text="E"
                android:layout_marginHorizontal="@dimen/_3sdp"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/_18ssp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letter2"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:background="@color/colorPrimary"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:layout_marginHorizontal="@dimen/_3sdp"
                android:gravity="center"
                android:text="H"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/_18ssp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letter3"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:background="@color/colorPrimary"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:layout_marginHorizontal="@dimen/_3sdp"
                android:gravity="center"
                android:text="H"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/_18ssp" />

            <Space
                android:id="@+id/s1"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp" />

            <Space
                android:id="@+id/s2"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp" />

            <Space
                android:id="@+id/s3"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/space1"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:background="@drawable/slot_edge_fade"
                android:elevation="0dp"
                android:layout_marginHorizontal="@dimen/_3sdp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/_18ssp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/space2"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:background="@drawable/slot_edge_fade"
                android:elevation="0dp"
                android:layout_marginHorizontal="@dimen/_3sdp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/_18ssp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/space3"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:background="@drawable/slot_edge_fade"
                android:elevation="0dp"
                android:layout_marginHorizontal="@dimen/_3sdp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/_18ssp" />
        </androidx.gridlayout.widget.GridLayout>
    </FrameLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:animateLayoutChanges="true"
        android:clipChildren="false"
        android:gravity="center"

        android:orientation="vertical">

        <Button
            android:id="@+id/continueButton"
            style="?attr/materialButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yantramanav_bold"
            android:text="NEXT" />

        <Button
            android:id="@+id/skipButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yantramanav_bold"
            android:text="SKIP TUTORIAL" />
    </androidx.appcompat.widget.LinearLayoutCompat>


</androidx.appcompat.widget.LinearLayoutCompat>
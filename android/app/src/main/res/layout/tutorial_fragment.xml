<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tutorial_fragment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/default_large_margin"
    android:gravity="center"
    android:orientation="vertical"
    app:divider="@drawable/divider"
    app:dividerPadding="@dimen/simple_dialog_header_left_margin"
    app:showDividers="middle"
    tools:context=".fragments.TutorialFragment">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:gravity="center"
        android:layout_margin="@dimen/default_gap"
        android:padding="@dimen/default_gap"
        android:orientation="vertical">

        <Button
            android:id="@+id/continueButton"
            style="@style/OC.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yantramanav_bold"
            android:drawableTint="@color/colorOnBackground"
            android:paddingVertical="@dimen/default_gap"
            android:drawableEnd="@drawable/ic_baseline_arrow_right_24"
            android:text="@string/next"
            android:textAppearance="@style/TextAppearance.OC.Headline5"
            android:textSize="@dimen/tutorial_primary_button_text_size" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="@dimen/tutorial_progress_width"
            android:layout_height="match_parent"
            android:progress="33"
            app:indicatorColor="@color/hintsNotificationColor" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/default_gap"
        android:padding="@dimen/default_gap"
        android:layout_weight="0.5"
        android:textAlignment="center"
        android:gravity="center"
        android:text="@string/tutorial_text"
        android:textColor="@color/colorOnPrimary"
        android:textSize="@dimen/tutorial_text_size" />

    <FrameLayout
        android:id="@+id/tutorialGameplay"
        android:layout_width="match_parent"
        android:layout_margin="@dimen/default_gap"
        android:padding="@dimen/default_gap"
        android:layout_height="0dp"
        android:layout_weight="2.5"
        android:animateLayoutChanges="true"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/tutorial_letters_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:animateLayoutChanges="true"
            android:clipChildren="false"
            android:splitMotionEvents="false"
            android:visibility="visible"
            app:columnCount="3"
            app:useDefaultMargins="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/r1"
                android:layout_width="@dimen/tutorial_arrow_size"
                android:layout_height="@dimen/tutorial_arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                android:backgroundTint="@color/rightToLeftColor"
                app:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/r2"
                android:layout_width="@dimen/tutorial_arrow_size"
                android:layout_height="@dimen/tutorial_arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                android:backgroundTint="@color/rightToLeftColor"
                app:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/r3"
                android:layout_width="@dimen/tutorial_arrow_size"
                android:layout_height="@dimen/tutorial_arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                android:backgroundTint="@color/rightToLeftColor"
                app:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letter1"
                android:layout_width="@dimen/tutorial_box_size"
                android:layout_height="@dimen/tutorial_box_size"
                android:background="@color/colorPrimary"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:text="H"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/tutorial_box_text_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letter2"
                android:layout_width="@dimen/tutorial_box_size"
                android:layout_height="@dimen/tutorial_box_size"
                android:background="@color/colorPrimary"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/tutorial_box_text_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letter3"
                android:layout_width="@dimen/tutorial_box_size"
                android:layout_height="@dimen/tutorial_box_size"
                android:background="@color/colorPrimary"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:text="H"
                android:textColor="@color/colorOnPrimary"
                android:textSize="@dimen/tutorial_box_text_size" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/l3"
                android:layout_width="@dimen/tutorial_arrow_size"
                android:layout_height="@dimen/tutorial_arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                android:backgroundTint="@color/leftToRightColor"
                android:rotationY="180"
                app:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/l2"
                android:layout_width="@dimen/tutorial_arrow_size"
                android:layout_height="@dimen/tutorial_arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                android:backgroundTint="@color/leftToRightColor"
                android:rotationY="180"
                app:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/l1"
                android:layout_width="@dimen/tutorial_arrow_size"
                android:layout_height="@dimen/tutorial_arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                android:backgroundTint="@color/leftToRightColor"
                android:rotationY="180"
                app:layout_gravity="center" />
        </androidx.gridlayout.widget.GridLayout>
    </FrameLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/default_large_margin"
        android:animateLayoutChanges="true"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="horizontal">

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
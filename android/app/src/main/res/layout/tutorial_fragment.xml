<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:saveEnabled="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/default_large_margin"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".fragments.TutorialFragment">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:saveEnabled="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:saveEnabled="true"
            style="@style/Widget.Material3.Button"
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatTextView
        android:saveEnabled="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/default_large_margin"
        android:layout_weight="0.5"
        android:gravity="start"
        android:text="@string/tutorial_text"
        android:textSize="@dimen/body_large_text_size" />

    <FrameLayout
        android:saveEnabled="true"
        android:id="@+id/tutorialGameplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.5"
        android:alpha="0"
        android:paddingBottom="@dimen/default_large_margin"
        android:animateLayoutChanges="true"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:saveEnabled="true"
            android:id="@+id/hand"
            android:layout_width="@dimen/box_text_size"
            android:layout_height="@dimen/box_text_size"
            android:background="@drawable/tutorial_hand_drawable"
            android:elevation="2dp" />

        <androidx.gridlayout.widget.GridLayout
            android:saveEnabled="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:animateLayoutChanges="true"
            android:clipChildren="false"
            android:splitMotionEvents="false"
            android:visibility="visible"
            app:columnCount="3"
            app:useDefaultMargins="true">

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="true"
                android:id="@+id/letter1"
                android:layout_width="@dimen/box_size"
                android:layout_height="@dimen/box_size"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:background="?colorSecondaryContainer"
                android:textColor="?colorOnSecondaryContainer"
                android:text="A"
                android:textSize="@dimen/box_text_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="true"
                android:id="@+id/letter2"
                android:layout_width="@dimen/box_size"
                android:layout_height="@dimen/box_size"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:background="?colorSecondaryContainer"
                android:textColor="?colorOnSecondaryContainer"
                android:text="H"
                android:textSize="@dimen/box_text_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="true"
                
                android:id="@+id/letter3"
                android:layout_width="@dimen/box_size"
                android:layout_height="@dimen/box_size"
                android:elevation="1dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:background="?colorSecondaryContainer"
                android:textColor="?colorOnSecondaryContainer"
                android:text="H"
                android:textSize="@dimen/box_text_size" />

            <androidx.appcompat.widget.AppCompatImageView
                android:saveEnabled="true"
                
                android:id="@+id/r1"
                android:layout_width="@dimen/arrow_size"
                android:layout_height="@dimen/arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                app:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatImageView
                android:saveEnabled="true"
                
                android:id="@+id/r2"
                android:layout_width="@dimen/arrow_size"
                android:layout_height="@dimen/arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                app:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatImageView
                android:saveEnabled="true"
                
                android:id="@+id/r3"
                android:layout_width="@dimen/arrow_size"
                android:layout_height="@dimen/arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                app:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="true"
                
                android:id="@+id/space1"
                android:layout_width="@dimen/box_size"
                android:layout_height="@dimen/box_size"
                android:background="?colorOutline"
                android:elevation="0dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:textSize="@dimen/box_text_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="true"
                
                android:id="@+id/space2"
                android:layout_width="@dimen/box_size"
                android:layout_height="@dimen/box_size"
                android:background="?colorOutline"
                android:elevation="0dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:textSize="@dimen/box_text_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="true"
                
                android:id="@+id/space3"
                android:layout_width="@dimen/box_size"
                android:layout_height="@dimen/box_size"
                android:background="?colorOutline"
                android:elevation="0dp"
                android:fontFamily="@font/yantramanav_bold"
                android:gravity="center"
                android:textSize="@dimen/box_text_size" />

            <androidx.appcompat.widget.AppCompatImageView
                android:saveEnabled="true"
                
                android:id="@+id/l3"
                android:layout_width="@dimen/arrow_size"
                android:layout_height="@dimen/arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                android:rotationY="180"
                app:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatImageView
                android:saveEnabled="true"
                
                android:id="@+id/l2"
                android:layout_width="@dimen/arrow_size"
                android:layout_height="@dimen/arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                android:rotationY="180"
                app:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatImageView
                android:saveEnabled="true"
                
                android:id="@+id/l1"
                android:layout_width="@dimen/arrow_size"
                android:layout_height="@dimen/arrow_size"
                android:alpha="0"
                android:background="@drawable/ic_baseline_double_arrow_24"
                android:rotationY="180"
                app:layout_gravity="center" />
        </androidx.gridlayout.widget.GridLayout>
    </FrameLayout>

</androidx.appcompat.widget.LinearLayoutCompat>
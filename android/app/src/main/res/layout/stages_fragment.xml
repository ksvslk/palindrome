<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:anybutton="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="@dimen/default_large_margin"
    app:divider="@drawable/divider"
    app:dividerPadding="@dimen/simple_dialog_header_left_margin"
    app:showDividers="middle">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/stages_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_header_height"
        android:layout_marginHorizontal="@dimen/simple_dialog_header_left_margin"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/levels"
            android:textAppearance="@style/TextAppearance.OC.Headline5" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/version_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:lineSpacingMultiplier="0.7"
            android:text="@string/placeholder"
            android:textAlignment="viewEnd"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.OC.Caption"
            android:textColor="@color/colorOnPrimaryDisabled"
            android:visibility="invisible" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.indest.hah.views.AnyButton
        android:id="@+id/submit_your_level_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:layout_margin="@dimen/_2sdp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        anybutton:any_button_icon="@drawable/ic_baseline_library_add_36"
        anybutton:any_button_title="@string/submit_level" />
    <com.indest.hah.views.AnyButton
        android:id="@+id/player_levels_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:layout_margin="@dimen/_2sdp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        anybutton:any_button_icon="@drawable/ic_baseline_groups_24"
        anybutton:any_button_title="@string/player_levels" />
    <com.indest.hah.views.AnyButton
        android:id="@+id/game_levels_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:layout_margin="@dimen/_2sdp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        anybutton:any_button_icon="@drawable/baseline_list_alt_black_36"
        anybutton:any_button_title="@string/game_levels" />
</androidx.appcompat.widget.LinearLayoutCompat>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
        <androidx.appcompat.widget.AppCompatImageView
            android:saveEnabled="false"
            tools:viewBindingIgnore="true"
            android:id="@+id/reward_button_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_item_left_margin"
            android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
            android:tint="?colorOnPrimaryContainer"
            android:clickable="false"
            tools:ignore="RtlSymmetry" />

        <ViewFlipper
            android:saveEnabled="false"
            
            android:id="@+id/reward_button_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:inAnimation="@android:anim/slide_in_left"
            android:outAnimation="@android:anim/slide_out_right">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:saveEnabled="false"
                
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:saveEnabled="false"
                    
                    android:id="@+id/reward_button_flipper_revealed_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/placeholder"
                    android:textAppearance="@style/TextAppearance.OC.Body1" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:saveEnabled="false"
                    
                    android:id="@+id/reward_button_flipper_revealed_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="?colorPrimary"
                    android:paddingHorizontal="@dimen/_3sdp"
                    android:text="@string/placeholder"
                    android:textAppearance="@style/TextAppearance.OC.Caption"
                    android:textColor="?colorOnPrimary" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:saveEnabled="false"
                
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:saveEnabled="false"
                    
                    android:id="@+id/reward_button_flipper_hidden_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="?colorTertiaryContainer"
                    android:padding="@dimen/_3sdp"
                    android:text="@string/placeholder"
                    android:textAppearance="@style/TextAppearance.OC.Body1"
                    android:textColor="?colorOnTertiaryContainer" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </ViewFlipper>
</merge>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:viewBindingIgnore="true">

    <androidx.appcompat.widget.AppCompatImageView
        android:saveEnabled="false"
        android:id="@+id/any_button_icon"
        android:tint="?colorOnPrimaryContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/simple_dialog_item_left_margin"
        android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
        android:clickable="false"
        tools:ignore="RtlSymmetry" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/simple_dialog_header_left_margin"
        android:clickable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="1">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:saveEnabled="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="false"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="false"
                android:id="@+id/any_button_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/placeholder"
                android:textAppearance="@style/TextAppearance.OC.Body1" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</merge>
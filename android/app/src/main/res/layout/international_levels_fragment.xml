<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:saveEnabled="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    app:divider="@drawable/divider"
    app:showDividers="middle">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/internationals_levels_title"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/simple_dialog_item_height"
            android:fontFamily="@font/roboto_medium"
            android:layout_gravity="center"
            android:padding="@dimen/default_large_margin"
            android:gravity="center"
            android:maxLines="2"
            app:autoSizeMaxTextSize="@dimen/body_large_text_size"
            app:autoSizeTextType="uniform"
            android:text="@string/send_levels_country_top"/>
    </androidx.appcompat.widget.LinearLayoutCompat>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/international_levels_recyclerview"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager">
    </androidx.recyclerview.widget.RecyclerView>

</androidx.appcompat.widget.LinearLayoutCompat>
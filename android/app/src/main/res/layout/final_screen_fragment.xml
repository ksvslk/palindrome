<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:anybutton="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:saveEnabled="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:saveEnabled="false"
        
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        anybutton:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ViewFlipper
            android:saveEnabled="false"
            
            android:id="@+id/reward_button_flipper_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:clickable="false"
            android:flipInterval="@integer/gameCompleteMessageFlipInterval"
            android:inAnimation="@android:anim/slide_in_left"
            android:outAnimation="@android:anim/slide_out_right">

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="false"
                
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/round_rectangle"
                android:gravity="center"
                android:paddingHorizontal="@dimen/default_large_margin"
                android:paddingVertical="@dimen/default_padding_text"
                android:text="@string/game_completed_shout"
                android:textAppearance="@style/TextAppearance.OC.Headline5" />

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="false"
                
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/round_rectangle"
                android:gravity="center"
                android:paddingHorizontal="@dimen/default_large_margin"
                android:paddingVertical="@dimen/default_padding_text"
                android:text="@string/game_completed_shout_smiley"
                android:textAppearance="@style/TextAppearance.OC.Headline5" />

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="false"
                
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/round_rectangle"
                android:gravity="center"
                android:paddingHorizontal="@dimen/default_large_margin"
                android:paddingVertical="@dimen/default_padding_text"
                android:text="@string/game_completed_shout_shout2"
                android:textAppearance="@style/TextAppearance.OC.Headline5" />

            <androidx.appcompat.widget.AppCompatTextView
                android:saveEnabled="false"
                
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/round_rectangle"
                android:gravity="center"
                android:paddingHorizontal="@dimen/default_large_margin"
                android:paddingVertical="@dimen/default_padding_text"
                android:text="@string/game_completed_shout_smiley2"
                android:textAppearance="@style/TextAppearance.OC.Headline5" />
        </ViewFlipper>

        <androidx.appcompat.widget.AppCompatTextView
            android:saveEnabled="false"
            
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/default_large_margin"
            android:layout_marginBottom="@dimen/tutorial_container_margin"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_32sdp"
            android:text="@string/final_screen_message"
            android:textAppearance="@style/TextAppearance.OC.Headline6" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:saveEnabled="false"
            
            android:id="@+id/final_screen_menu_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            app:divider="@drawable/divider"
            app:showDividers="middle">

            <com.indest.hah.views.AnyButton
                android:saveEnabled="false"
                
                android:id="@+id/submit_your_own"
                android:layout_width="match_parent"
                android:layout_height="@dimen/simple_dialog_item_height"
                android:layout_margin="@dimen/_2sdp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                anybutton:any_button_icon="@drawable/ic_baseline_library_add_36"
                anybutton:any_button_title="@string/submit_level" />

            <com.indest.hah.views.AnyButton
                android:saveEnabled="false"
                
                android:id="@+id/share_button_player"
                android:layout_width="match_parent"
                android:layout_height="@dimen/simple_dialog_item_height"
                android:layout_margin="@dimen/_2sdp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                anybutton:any_button_icon="@drawable/baseline_share_black_36"
                anybutton:any_button_title="@string/share" />

            <com.indest.hah.views.AnyButton
                android:saveEnabled="false"
                
                android:id="@+id/feedback_button_player"
                android:layout_width="match_parent"
                android:layout_height="@dimen/simple_dialog_item_height"
                android:layout_margin="@dimen/_2sdp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                anybutton:any_button_icon="@drawable/baseline_rate_review_black_36"
                anybutton:any_button_title="@string/rate_game" />

            <com.indest.hah.views.AnyButton
                android:saveEnabled="false"
                
                android:id="@+id/level_select_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/simple_dialog_item_height"
                android:layout_margin="@dimen/_2sdp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                anybutton:any_button_icon="@drawable/baseline_list_alt_black_36"
                anybutton:any_button_title="@string/level_select" />

            <com.indest.hah.views.AnyButton
                android:saveEnabled="false"
                
                android:id="@+id/player_level_select_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/simple_dialog_item_height"
                android:layout_margin="@dimen/_2sdp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                anybutton:any_button_icon="@drawable/ic_baseline_groups_24"
                anybutton:any_button_title="@string/player_level_select" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="@dimen/default_large_margin"
    app:divider="@drawable/divider"
    app:dividerPadding="@dimen/simple_dialog_left_margin"
    app:showDividers="middle">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/hints_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_header_height"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:text="@string/hints"
            android:textAppearance="@style/TextAppearance.OC.Headline5" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/category_reveal_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:layout_margin="@dimen/_2sdp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
            android:contentDescription="@string/rewarded_reveal_clue"
            android:clickable="false"
            android:src="@drawable/baseline_category_black_36"
            app:tint="@color/colorOnPrimary"
            tools:ignore="RtlSymmetry" />

        <ViewFlipper
            android:id="@+id/reveal_category_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:inAnimation="@android:anim/slide_in_left"
            android:outAnimation="@android:anim/slide_out_right">

            <include
                android:id="@+id/reveal_category_hidden"
                layout="@layout/hint_available"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/reveal_category_shown"
                layout="@layout/hint_revealed"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </ViewFlipper>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/letter_place_button"
        android:layout_width="match_parent"
        android:layout_margin="@dimen/_2sdp"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
            android:clickable="false"
            android:contentDescription="@string/rewarded_place_letter"
            android:src="@drawable/baseline_check_box_black_36"
            app:tint="@color/colorOnPrimary"
            tools:ignore="RtlSymmetry" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:clickable="false"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/rewarded_place_letter"
                android:textAppearance="@style/TextAppearance.OC.Body1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/place_letter_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/watch_rewarded_video"
                android:paddingHorizontal="@dimen/_3sdp"
                android:background="@color/colorPrimary"
                android:textColor="@color/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.OC.Caption" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/instant_clues_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:layout_margin="@dimen/_2sdp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
            android:contentDescription="@string/remove_clue_ads_text"
            android:src="@drawable/baseline_lock_black_36"
            android:clickable="false"
            app:tint="@color/colorOnPrimary"
            tools:ignore="RtlSymmetry" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:clickable="false"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/instant_clues_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/remove_clue_ads_text"
                android:textAppearance="@style/TextAppearance.OC.Body1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/instant_clues_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text=""
                android:paddingHorizontal="@dimen/_3sdp"
                android:background="@color/colorSecondary"
                android:textColor="@color/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.OC.Caption" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/instant_letters_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:layout_margin="@dimen/_2sdp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
            android:contentDescription="@string/remove_letter_ads_text"
            android:clickable="false"
            android:src="@drawable/baseline_lock_black_36"
            app:tint="@color/colorOnPrimary"
            tools:ignore="RtlSymmetry" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="false"
            android:weightSum="2">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:clickable="false"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/instant_letters_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/remove_letter_ads_text"
                    android:textAppearance="@style/TextAppearance.OC.Body1" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/instant_letters_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text=""
                    android:paddingHorizontal="@dimen/_3sdp"
                    android:background="@color/colorSecondary"
                    android:textColor="@color/colorOnPrimary"
                    android:textAppearance="@style/TextAppearance.OC.Caption" />
            </androidx.appcompat.widget.LinearLayoutCompat>


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:layout_marginRight="@dimen/simple_dialog_left_margin"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_3sdp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/colorSecondary"
                    android:textColor="@color/colorOnPrimary"
                    android:text="BEST"
                    android:textAppearance="@style/TextAppearance.OC.Caption" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text=" - "
                    android:textAppearance="@style/TextAppearance.OC.Caption" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_3sdp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/colorOnPrimary"
                    android:textColor="@color/colorPrimary"
                    android:text="LOVED"
                    android:textAppearance="@style/TextAppearance.OC.Caption" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/no_intermediate_ads_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:layout_margin="@dimen/_2sdp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
            android:contentDescription="@string/remove_intermediate_ads_text"
            android:src="@drawable/baseline_lock_black_36"
            android:clickable="false"
            app:tint="@color/colorOnPrimary"
            tools:ignore="RtlSymmetry" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:clickable="false"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/remove_intermediate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/remove_intermediate_ads_text"
                android:textAppearance="@style/TextAppearance.OC.Body1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/remove_intermediate_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text=""
                android:paddingHorizontal="@dimen/_3sdp"
                android:background="@color/colorSecondary"
                android:textColor="@color/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.OC.Caption" />
        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/full_no_ads_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:layout_margin="@dimen/_2sdp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
            android:contentDescription="@string/remove_all_ads_text"
            android:src="@drawable/baseline_lock_black_36"
            android:clickable="false"
            app:tint="@color/colorOnPrimary"
            tools:ignore="RtlSymmetry" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layout_marginRight="@dimen/simple_dialog_left_margin"
            android:clickable="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:clickable="false"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/full_no_ads_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/remove_all_ads_text"
                    android:textAppearance="@style/TextAppearance.OC.Body1" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/full_no_ads_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text=""
                    android:paddingHorizontal="@dimen/_3sdp"
                    android:background="@color/colorSecondary"
                    android:textColor="@color/colorOnPrimary"
                    android:textAppearance="@style/TextAppearance.OC.Caption" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/fullAdsSavingsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_3sdp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/colorSecondary"
                    android:textColor="@color/colorOnPrimary"
                    android:text="SAVE"
                    android:textAppearance="@style/TextAppearance.OC.Caption" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text=" "
                    android:textAppearance="@style/TextAppearance.OC.Caption" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_3sdp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/colorOnPrimary"
                    android:textColor="@color/colorPrimary"
                    android:text="24%"
                    android:textAppearance="@style/TextAppearance.OC.Caption" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
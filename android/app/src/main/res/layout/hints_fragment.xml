<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    app:divider="@drawable/divider"
    app:showDividers="middle"
    app:dividerPadding="@dimen/simple_dialog_left_margin"
    android:orientation="vertical"
    android:paddingVertical="@dimen/default_large_margin">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/hints_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_header_height"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:text="@string/hints"
            android:textAppearance="@style/TextAppearance.OC.Headline5" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/category_reveal_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
            android:contentDescription="@string/rewarded_reveal_category"
            android:src="@drawable/category_icon"
            app:tint="@color/colorOnPrimary"
            tools:ignore="RtlSymmetry" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/rewarded_reveal_category"
                android:textAppearance="@style/TextAppearance.OC.Body1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/watch_rewarded_video"
                android:textAppearance="@style/TextAppearance.OC.Caption" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/letter_place_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
            android:contentDescription="@string/rewarded_place_letter"
            android:src="@drawable/letter_icon"
            app:tint="@color/colorOnPrimary"
            tools:ignore="RtlSymmetry" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/rewarded_place_letter"
                android:textAppearance="@style/TextAppearance.OC.Body1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/watch_rewarded_video"
                android:textAppearance="@style/TextAppearance.OC.Caption" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/all_categories_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
            android:contentDescription="@string/iap_unlock_categories"
            android:src="@drawable/lock_icon"
            app:tint="@color/colorOnPrimary"
            tools:ignore="RtlSymmetry" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/iap_unlock_categories"
                android:textAppearance="@style/TextAppearance.OC.Body1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/all_categories_price"
                android:textAppearance="@style/TextAppearance.OC.Caption" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/unlock_all_hints_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/simple_dialog_left_margin"
            android:layout_marginEnd="@dimen/simple_dialog_divider_margin"
            android:contentDescription="@string/iap_unlock_hints"
            android:src="@drawable/lock_icon"
            app:tint="@color/colorOnPrimary"
            tools:ignore="RtlSymmetry" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/iap_unlock_hints"
                android:textAppearance="@style/TextAppearance.OC.Body1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/all_hints_price"
                android:textAppearance="@style/TextAppearance.OC.Caption" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/submit_level_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="@dimen/default_large_margin"
    app:dividerPadding="@dimen/simple_dialog_header_left_margin"
    app:showDividers="middle">



    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Design.TextInputLayout"
        android:id="@+id/enter_palindrome_TextInputLayout"
        app:startIconDrawable="@drawable/ic_baseline_compare_arrows_24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/default_large_margin"
        android:layout_margin="@dimen/def"
        app:endIconMode="custom"
        app:errorIconDrawable="@drawable/ic_baseline_error_24"
        app:errorEnabled="true"
        app:helperTextEnabled="true"
        app:counterEnabled="true">

        <com.indest.hah.other.TextInputEditTextWithError
            android:id="@+id/enter_palindrome_TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/ThemeOverlay.Material3.TextInputEditText.FilledBox"
            android:textSize="@dimen/_12ssp"
            android:hint="@string/send_level_input_hint"
            android:inputType="textNoSuggestions|textCapCharacters"/>

    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/send_level_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:layout_marginHorizontal="@dimen/simple_dialog_item_left_margin"
        style="@style/Widget.AppCompat.Button.Colored"
        android:textColor="@color/colorOnSecondary"
        android:text="@string/send">
    </androidx.appcompat.widget.AppCompatButton>

</androidx.appcompat.widget.LinearLayoutCompat>
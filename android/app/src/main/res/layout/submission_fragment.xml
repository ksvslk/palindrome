<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:saveEnabled="false"
    android:id="@+id/submit_level_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/default_large_margin"
    app:showDividers="middle">

    <com.google.android.material.textfield.TextInputLayout
        android:saveEnabled="false"
        
        android:id="@+id/enter_palindrome_TextInputLayout"
        style="@style/Widget.Design.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/def"
        android:layout_marginHorizontal="@dimen/default_large_margin"
        android:textColorHint="@color/textOnRewardedColor"
        app:counterEnabled="true"
        app:counterMaxLength="@integer/maxUserPalindromeLength"
        app:endIconMode="custom"
        app:errorEnabled="true"
        app:errorIconDrawable="@drawable/ic_baseline_error_24"
        app:startIconDrawable="@drawable/ic_baseline_compare_arrows_24">

        <com.indest.hah.other.TextInputEditTextWithError
            android:saveEnabled="false"
            
            android:id="@+id/enter_palindrome_TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/send_level_input_hint"
            android:inputType="textNoSuggestions|textCapCharacters"
            android:textSize="@dimen/_12ssp" />
    </com.google.android.material.textfield.TextInputLayout>

    <ViewFlipper
        android:saveEnabled="false"
        
        android:id="@+id/send_level_flipper"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height">

        <androidx.appcompat.widget.AppCompatButton
            android:saveEnabled="false"
            
            android:id="@+id/send_level_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="match_parent"
            android:layout_height="@dimen/simple_dialog_item_height"
            android:layout_marginHorizontal="@dimen/simple_dialog_item_left_margin"
            android:text="@string/send"
            android:textColor="@color/colorOnPrimary" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:saveEnabled="false"
            
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" >
        </com.google.android.material.progressindicator.LinearProgressIndicator>

        <RelativeLayout
            android:saveEnabled="false"
            
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:saveEnabled="false"
                
                android:id="@+id/send_level_success_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:saveEnabled="false"
                    
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/default_gap"
                    android:background="@drawable/baseline_check_box_black_36"
                    android:backgroundTint="@color/successBoxColor" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:saveEnabled="false"
                    
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/palindrome_successfully_sent"
                    android:textAppearance="@style/TextAppearance.OC.Body1" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:saveEnabled="false"
                
                android:id="@+id/send_level_failed_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">
                <androidx.appcompat.widget.AppCompatImageView
                    android:saveEnabled="false"
                    
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/default_gap"
                    android:background="@drawable/ic_baseline_error_24" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:saveEnabled="false"
                    
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/something_went_wrong"
                    android:layout_marginEnd="@dimen/default_large_margin"
                    android:textAppearance="@style/TextAppearance.OC.Body1" />

                <androidx.appcompat.widget.AppCompatButton
                    android:saveEnabled="false"
                    
                    android:id="@+id/send_level_failed_button"
                    style="@style/Widget.AppCompat.Button.Colored"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/simple_dialog_item_height"
                    android:paddingHorizontal="@dimen/default_gap"
                    android:text="@string/try_again"
                    android:textColor="@color/colorOnPrimary" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </RelativeLayout>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
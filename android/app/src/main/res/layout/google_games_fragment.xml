<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent">
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:anybutton="http://schemas.android.com/apk/res-auto"
    android:saveEnabled="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:paddingVertical="@dimen/default_large_margin"
    app:divider="@drawable/divider"
    app:showDividers="middle"
    android:orientation="vertical">

    <com.indest.hah.views.AnyButton
        android:saveEnabled="true"
        android:id="@+id/global_leaderboards_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        anybutton:any_button_icon="@drawable/baseline_language_36"
        anybutton:any_button_title="@string/global_leaderboards" />

    <com.indest.hah.views.AnyButton
        android:saveEnabled="true"
        android:id="@+id/leaderboards_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        anybutton:any_button_icon="@drawable/games_leaderboards"
        anybutton:any_button_title="@string/leaderboard" />

    <com.indest.hah.views.AnyButton
        android:saveEnabled="true"
        android:id="@+id/player_levels_leaderboard_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        anybutton:any_button_icon="@drawable/ic_baseline_leaderboard_24"
        anybutton:any_button_title="@string/player_leaderboard_text" />

    <com.indest.hah.views.AnyButton
        android:saveEnabled="true"
        android:id="@+id/achievements_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/simple_dialog_item_height"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        anybutton:any_button_icon="@drawable/games_achievements"
        anybutton:any_button_title="@string/achievements" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:saveEnabled="true"
        android:id="@+id/alternative_screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:saveEnabled="true"
            android:id="@+id/alternative_text"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="@dimen/simple_dialog_item_height"
            android:layout_gravity="center"
            app:autoSizeMaxTextSize="@dimen/body_large_text_size"
            app:autoSizeTextType="uniform"
            android:text="@string/please_sign_in"
            />
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
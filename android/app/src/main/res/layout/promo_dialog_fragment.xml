<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?colorPrimary"
    android:orientation="vertical">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/promo_picture"
        android:layout_gravity="center"
        android:padding="@dimen/default_large_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:shapeAppearanceOverlay="@style/roundedCornersImageView"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_baseline_error_24"
        android:contentDescription="@string/picture_hint" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/promo_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textSize="@dimen/default_large_margin"
        android:textColor="?colorOnPrimary"
                android:paddingHorizontal="@dimen/default_large_margin"
        android:text="TextView" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/promo_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textSize="@dimen/body_medium_text_size"
        android:textColor="?colorOnPrimary"
        android:paddingBottom="@dimen/default_large_margin"
        android:paddingHorizontal="@dimen/default_large_margin"
        android:text="TextView" />

</androidx.appcompat.widget.LinearLayoutCompat>
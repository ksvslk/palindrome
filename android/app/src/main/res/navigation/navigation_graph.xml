<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/navigation_level">

    <fragment
        android:id="@+id/navigation_level"
        android:name="com.indest.hah.fragments.LevelFragment"
        android:label="LevelFragment"
        tools:layout="@layout/level_fragment">
        <action
            android:id="@+id/action_navigation_gameplay_to_navigation_hints"
            app:destination="@id/navigation_goods" />
        <action
            android:id="@+id/action_navigation_gameplay_to_navigation_google_games"
            app:destination="@id/navigation_google_games" />
        <action
            android:id="@+id/action_navigation_gameplay_to_navigation_settings"
            app:destination="@id/navigation_settings" />
        <action
            android:id="@+id/action_navigation_level_to_navigation_epilogue"
            app:destination="@id/navigation_epilogue" />
        <action
            android:id="@+id/action_navigation_level_to_navigation_stages"
            app:destination="@id/navigation_stages" />
    </fragment>

    <fragment
        android:id="@+id/navigation_tutorial"
        android:name="com.indest.hah.fragments.TutorialFragment"
        android:label="@string/tutorial"
        tools:layout="@layout/tutorial_fragment" >
        <action
            android:id="@+id/action_navigation_tutorial_to_navigation_second_tutorial"
            app:destination="@id/navigation_second_tutorial" />
        <action
            android:id="@+id/action_navigation_tutorial_to_navigation_level"
            app:destination="@id/navigation_level" />
    </fragment>

    <fragment
        android:id="@+id/navigation_second_tutorial"
        android:name="com.indest.hah.fragments.SecondTutorialFragment"
        android:label="@string/tutorial"
        tools:layout="@layout/second_tutorial_fragment" >
        <action
            android:id="@+id/action_navigation_second_tutorial_to_navigation_third_tutorial"
            app:destination="@id/navigation_third_tutorial" />
        <action
            android:id="@+id/action_navigation_second_tutorial_to_navigation_tutorial"
            app:destination="@id/navigation_tutorial" />
    </fragment>

    <fragment
        android:id="@+id/navigation_third_tutorial"
        android:name="com.indest.hah.fragments.ThirdTutorialFragment"
        android:label="@string/tutorial"
        tools:layout="@layout/third_tutorial_fragment" >
        <action
            android:id="@+id/action_navigation_third_tutorial_to_navigation_second_tutorial"
            app:destination="@id/navigation_second_tutorial" />
        <action
            android:id="@+id/action_navigation_third_tutorial_to_navigation_level"
            app:destination="@id/navigation_level" />
    </fragment>


    <fragment
        android:id="@+id/navigation_epilogue"
        android:name="com.indest.hah.fragments.EpilogueFragment"
        android:label="EpilogueFragment"
        tools:layout="@layout/epilogue_fragment">
        <action
            android:id="@+id/action_navigation_epilogue_to_navigation_level"
            app:destination="@id/navigation_level" />
    </fragment>


    <dialog
        android:id="@+id/navigation_goods"
        android:name="com.indest.hah.fragments.HintsFragment"
        android:label="@string/hints"
        tools:layout="@layout/hints_fragment" >
        <action
            android:id="@+id/action_navigation_goods_to_navigation_gameplay"
            app:destination="@id/navigation_level" />
    </dialog>

    <dialog
        android:id="@+id/navigation_google_games"
        android:name="com.indest.hah.fragments.GoogleGamesFragment"
        android:label="@string/play_games"
        tools:layout="@layout/google_games_fragment" >
        <action
            android:id="@+id/action_navigation_google_games_to_navigation_gameplay"
            app:destination="@id/navigation_level" />
    </dialog>

    <dialog
        android:id="@+id/navigation_settings"
        android:name="com.indest.hah.fragments.SettingsFragment"
        android:label="@string/settings"
        tools:layout="@layout/settings_fragment" >
        <action
            android:id="@+id/action_navigation_settings_to_navigation_gameplay"
            app:destination="@id/navigation_level" />
        <action
            android:id="@+id/action_navigation_settings_to_navigation_level_select"
            app:destination="@id/navigation_level_select" />
    </dialog>

    <dialog
        android:id="@+id/navigation_stages"
        android:name="com.indest.hah.fragments.StagesFragment"
        android:label="@string/stages"
        tools:layout="@layout/stages_fragment" >
        <action
            android:id="@+id/action_navigation_stages_to_navigation_level"
            app:destination="@id/navigation_level" />
        <action
            android:id="@+id/action_navigation_stages_to_navigation_level_select"
            app:destination="@id/navigation_level_select" />
        <action
            android:id="@+id/action_navigation_stages_to_navigation_submission"
            app:destination="@id/navigation_submission" />
    </dialog>

    <dialog
        android:id="@+id/navigation_submission"
        android:name="com.indest.hah.fragments.SubmissionFragment"
        android:label="@string/submit_level"
        tools:layout="@layout/submission_fragment" >
        <action
            android:id="@+id/action_navigation_submission_to_navigation_level"
            app:destination="@id/navigation_level" />
    </dialog>

    <dialog
        android:id="@+id/navigation_level_select"
        android:name="com.indest.hah.fragments.LevelSelectFragment"
        android:label="@string/level_select"
        tools:layout="@layout/level_select_fragment" >
        <action
            android:id="@+id/action_navigation_level_select_to_navigation_settings"
            app:destination="@id/navigation_level" />
    </dialog>


</navigation>